# Copy to .env and edit. .env is gitignored.
#
# This file mirrors DESIGN.md §7 and config.py. A sync test
# (tests/unit/test_env_sync.py) fails CI if the three drift.

# ─── Service ──────────────────────────────────────────────────────────
# Logical name used in logs and traces.
SERVICE_NAME=sandbox-ctl
# dev | staging | prod. Gates verbose logging and prod-only guards.
SERVICE_ENV=dev

# ─── HTTP ─────────────────────────────────────────────────────────────
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Max wall time for any single API request, seconds.
HTTP_REQUEST_TIMEOUT_S=30

# ─── Runtime driver ───────────────────────────────────────────────────
# kubernetes (prod) | docker (local dev). Picks the Driver + AgentClient pair.
RUNTIME_BACKEND=kubernetes
# firecracker | container. K8s isolation tier; ignored by the docker backend.
RUNTIME_DRIVER=container
# REQUIRED. Base URL of the runtime driver API. Read only by the K8s backend.
RUNTIME_API_URL=<set-in-prod>
# REQUIRED. How the control plane reaches the in-sandbox agent. Ignored by docker.
AGENT_GRPC_ENDPOINT=<set-in-prod>
# Timeout for a single agent RPC, seconds.
AGENT_TIMEOUT_S=10
# Optional Docker network for sandbox containers (docker backend only).
# Empty string = default bridge.
DOCKER_NETWORK=

# ─── Warm pool ────────────────────────────────────────────────────────
# Pre-booted sandboxes kept ready per flavor.
WARM_POOL_SIZE=16
# Max age of an unused warm sandbox, seconds.
WARM_POOL_MAX_IDLE_S=600
# How many sandboxes we boot in parallel during refill.
WARM_POOL_REFILL_CONCURRENCY=4

# ─── Snapshot store ───────────────────────────────────────────────────
# REQUIRED. Object store base URL.
SNAPSHOT_STORE_URL=<set-in-prod>
# REQUIRED. Bucket / container name.
SNAPSHOT_STORE_BUCKET=sandbox-snapshots
# REQUIRED. Access key id.
SNAPSHOT_STORE_KEY_ID=change-me
# REQUIRED. Access secret. Never logged.
SNAPSHOT_STORE_SECRET=change-me

# ─── Session limits ───────────────────────────────────────────────────
# Hard cap on a session's wall time, seconds.
SESSION_MAX_WALL_S=300
# Hard cap on CPU time, milliseconds.
SESSION_MAX_CPU_MS=60000
# Memory ceiling per sandbox, MB.
SESSION_MAX_MEMORY_MB=512
# PID limit inside the sandbox.
SESSION_MAX_PIDS=256
# Writable scratch size per sandbox, MB.
SESSION_SCRATCH_MB=256

# ─── Tenant quotas ────────────────────────────────────────────────────
# Concurrent sessions per tenant.
TENANT_MAX_CONCURRENT=32
# Session creations per second per tenant (token bucket).
TENANT_QUOTA_RPS=20

# ─── Egress ───────────────────────────────────────────────────────────
# deny (default) | allow (dev-only).
EGRESS_DEFAULT_POLICY=deny
# Path to the allowlist YAML.
EGRESS_ALLOWLIST_PATH=/etc/sandbox-ctl/egress.yaml

# ─── Credentials ──────────────────────────────────────────────────────
# REQUIRED. Path to the HMAC signing key for short-lived session credentials.
# Must exist and be >= 32 bytes. Local: head -c 64 /dev/urandom > .venv/signing.key
CREDS_SIGNING_KEY_PATH=<set-in-prod>
# Lifetime of minted credentials, seconds.
CREDS_TTL_S=300

# ─── Telemetry & logging ──────────────────────────────────────────────
# OTLP collector endpoint. Empty disables export.
OTLP_ENDPOINT=
# Trace sampling, 0.0..1.0.
OTLP_SAMPLE_RATIO=0.1
# Prometheus scrape port.
METRICS_PORT=9090
# Root log level.
LOG_LEVEL=INFO
# json | text.
LOG_FORMAT=json

# ─── Kubernetes ───────────────────────────────────────────────────────
# true inside the cluster; false when using a local kubeconfig.
KUBE_IN_CLUSTER=true
# Namespace where sandbox Pods are created.
KUBE_NAMESPACE=sandbox
# Only used when KUBE_IN_CLUSTER=false.
KUBE_KUBECONFIG_PATH=
# RuntimeClass for the microVM tier.
RUNTIME_CLASS_MVM=kata-mvm
# RuntimeClass for the hardened container tier.
RUNTIME_CLASS_CTR=runc-hardened
# Label selector for sandbox nodes.
SANDBOX_NODE_SELECTOR=role=sandbox
# REQUIRED. ImagePullSecret for private base images.
SANDBOX_IMAGE_PULL_SECRET=<set-in-prod>
# Preempted when on-demand sessions arrive.
WARM_POOL_PRIORITY_CLASS=warm-preemptible
# Normal priority for leased sessions.
ONDEMAND_PRIORITY_CLASS=sandbox-ondemand
# Localhost seccomp profile path.
POD_SECCOMP_PROFILE=sandbox/default.json
